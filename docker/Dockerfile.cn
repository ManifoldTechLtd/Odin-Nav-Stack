# =============================================================================
# Odin Navigation Stack — Docker image (mainland China apt/pip mirror sources)
#
# Identical to Dockerfile.global except apt and pip use Tsinghua mirrors.
#
# Build:
#   docker build -f docker/Dockerfile.cn -t odin-nav:latest .
# =============================================================================

ARG BASE_IMAGE=dustynv/ros:noetic-pytorch-l4t-r35.4.1
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=noetic \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CONDA_DIR=/opt/conda \
    PATH=/opt/conda/bin:/opt/conda/envs/neupan/bin:${PATH}

# -----------------------------------------------------------------------------
# 0. Switch apt and pip to Tsinghua mirrors
# -----------------------------------------------------------------------------
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|https://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g; \
            s|http://security.ubuntu.com/ubuntu/|https://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g; \
            s|http://ports.ubuntu.com/ubuntu-ports/|https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports/|g' \
        /etc/apt/sources.list \
    && mkdir -p /root/.pip \
    && printf "[global]\nindex-url = https://pypi.tuna.tsinghua.edu.cn/simple\ntrusted-host = pypi.tuna.tsinghua.edu.cn\n" > /root/.pip/pip.conf

# -----------------------------------------------------------------------------
# 1. System dependencies (matches README §2)
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        wget \
        curl \
        ca-certificates \
        sudo \
        libpcl-dev \
        libeigen3-dev \
        libopencv-dev \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-tf2-eigen \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-move-base \
        ros-${ROS_DISTRO}-dwa-local-planner \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2. Miniforge + `neupan` python 3.10 env
# -----------------------------------------------------------------------------
RUN wget --quiet -O /tmp/miniforge.sh \
        https://mirrors.tuna.tsinghua.edu.cn/github-release/conda-forge/miniforge/LatestRelease/Miniforge3-Linux-aarch64.sh \
    && bash /tmp/miniforge.sh -b -p ${CONDA_DIR} \
    && rm /tmp/miniforge.sh \
    && conda config --set show_channel_urls yes \
    && conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/conda-forge \
    && conda create -n neupan -y python=3.10 \
    && conda clean -afy

# -----------------------------------------------------------------------------
# 3. Copy source and install NeuPAN deps
# -----------------------------------------------------------------------------
WORKDIR /opt/odin
COPY NeuPAN /opt/odin/NeuPAN

RUN /opt/conda/envs/neupan/bin/pip install --no-cache-dir \
        torch==2.1.0 -i https://pypi.tuna.tsinghua.edu.cn/simple \
    && /opt/conda/envs/neupan/bin/pip install --no-cache-dir -e /opt/odin/NeuPAN

# -----------------------------------------------------------------------------
# 4. Build the ROS workspace
# -----------------------------------------------------------------------------
COPY ros_ws/src/CMakeLists.txt              /opt/odin/ros_ws/src/CMakeLists.txt
COPY ros_ws/src/odin_ros_driver             /opt/odin/ros_ws/src/odin_ros_driver
COPY ros_ws/src/map_planner                 /opt/odin/ros_ws/src/map_planner
COPY ros_ws/src/fake360                     /opt/odin/ros_ws/src/fake360
COPY ros_ws/src/pcd2pgm                     /opt/odin/ros_ws/src/pcd2pgm
COPY ros_ws/src/pointcloud_saver            /opt/odin/ros_ws/src/pointcloud_saver
COPY scripts                                /opt/odin/scripts

RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash \
    && cd /opt/odin/ros_ws \
    && catkin_make -DCMAKE_BUILD_TYPE=Release"

# -----------------------------------------------------------------------------
# 5. Persistent map mount points (see docker-compose.yml "Persistent map data")
# -----------------------------------------------------------------------------
RUN mkdir -p /opt/odin/maps/relocalization \
             /opt/odin/maps/grid \
             /opt/odin/maps/pcd

# -----------------------------------------------------------------------------
# 6. Entrypoint
# -----------------------------------------------------------------------------
COPY docker/entrypoint.sh /opt/odin/entrypoint.sh
RUN chmod +x /opt/odin/entrypoint.sh

ENV ROS_MASTER_URI=http://localhost:11311 \
    ROS_HOSTNAME=localhost

ENTRYPOINT ["/opt/odin/entrypoint.sh"]
CMD ["launch"]
